<launch>
  <!-- People perception on the scans of FAST-LIO (docs/perception_pipeline.md). Included by fast_lio
       fast_lio_slam_launch.xml (its people argument): do not launch it by hand next to that one.

       people:=false  only dynamic_points_filter, as a pass-through: SC-PGO and TARE read the FAST-LIO scans through it
                        /cloud_registered       -> /registered_scan_static          (TARE, and the terrain maps
                                                                                     far_planner builds its graph on)
                        /cloud_registered_body  -> /cloud_registered_body_static    (SC-PGO)
                      They get no scans while it is not running.
       people:=true   the whole chain, and the filter takes the tracked people out of the two clouds:
                        /cloud_registered_body + /Odometry -> detector_cloud_adapter -> /perception/detector/pointcloud
                        -> autoware_lidar_centerpoint -> /perception/detector/objects -> people_tracker
                        -> /perception/tracks, /perception/tracks_all, /perception/tracks_markers
                        -> dynamic_points_filter
                        /perception/tracks -> obstacle_adapter -> /perception/dynamic_obstacles (the people as
                        obstacles for an Optimistic-Pessimistic MPC, frame camera_init)
                        -> dynamic_obstacles_to_opti_pessi_obstacles.py -> /opti_pessi/obstacles
                        (frame odom, what OptiPessiController reads; needs the odom -> lio_map TF of
                        lio_odom_alignment.py, which explore_warehouse_launch.xml starts). opti_pessi_obstacles:=false
                        leaves that topic to another publisher, as the camera detector yolo26_rgbd_detect: every
                        message there replaces the obstacles of the previous one, two publishers erase each other.
                      The detector is the CenterPoint model in centerpoint_model, run by
                        detector:=centerpoint      autoware_lidar_centerpoint: CUDA and TensorRT
                        detector:=centerpoint_cpu  centerpoint_cpu.py: ONNX Runtime on the CPU, same model, same
                                                   topics, a smaller area (config/centerpoint_cpu.param.yaml); with
                                                   the python of a venv that has onnxruntime (python argument)
                        detector:=auto             the first when autoware_lidar_centerpoint is installed, else the
                                                   second (a setup_ranav.sh build without CUDA leaves it out)
       The model and the venv are looked for in the workspace this package is installed from (<ws>/install/..). -->
  <arg name="detector" default="auto" description="auto (centerpoint when autoware_lidar_centerpoint is installed, else centerpoint_cpu), centerpoint (TensorRT, needs CUDA) or centerpoint_cpu (ONNX Runtime on the CPU)"/>
  <arg name="python" default="$(find-pkg-prefix people_perception)/../../.venv-yolo/bin/python" description="With detector:=centerpoint_cpu: interpreter that has onnxruntime"/>
  <arg name="people" default="false" description="Detect and track people and take them out of the scans for SC-PGO and TARE"/>
  <arg name="centerpoint_model" default="$(find-pkg-prefix people_perception)/../../models/lidar_centerpoint/v4.1/short_range"
       description="Folder of the CenterPoint model: its two .onnx, ml_package.param.yaml, detection_class_remapper.param.yaml; the TensorRT engines are built there on the first start"/>
  <arg name="opti_pessi_obstacles" default="true"
       description="With people:=true: the tracked people are the obstacles of OptiPessiController (/perception/dynamic_obstacles -> /opti_pessi/obstacles). false when another node publishes /opti_pessi/obstacles"/>
  <arg name="use_sim_time" default="true"/>

  <let name="config" value="$(find-pkg-share people_perception)/config"/>
  <let if="$(equals $(var detector) auto)" name="detector"
       value="$(eval &quot;'centerpoint' if ament_index_python.has_resource('packages', 'autoware_lidar_centerpoint') else 'centerpoint_cpu'&quot; ament_index_python)"/>

  <node pkg="people_perception" exec="dynamic_points_filter" name="dynamic_points_filter" output="screen">
    <param from="$(var config)/dynamic_points_filter.yaml"/>
    <param name="enabled" value="$(var people)"/>
  </node>

  <group if="$(var people)">
    <node pkg="people_perception" exec="detector_cloud_adapter" name="detector_cloud_adapter" output="screen">
      <param from="$(var config)/detector_cloud_adapter.yaml"/>
    </node>
    <node pkg="people_perception" exec="people_tracker" name="people_tracker" output="screen">
      <param from="$(var config)/people_tracker.yaml"/>
      <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>
    <node pkg="people_perception" exec="obstacle_adapter" name="obstacle_adapter" output="screen">
      <param from="$(var config)/obstacle_adapter.yaml"/>
    </node>
    <node if="$(var opti_pessi_obstacles)" pkg="people_perception" exec="dynamic_obstacles_to_opti_pessi_obstacles.py"
          name="dynamic_obstacles_to_opti_pessi_obstacles" output="screen">
      <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>
    <!-- The detector. Its engines are built on the first start (minutes; they are not portable between
         machines or TensorRT versions). The pretrained Autoware models were trained on road data: a proof that the
         chain runs, not a people detector for a warehouse. -->
    <include if="$(equals $(var detector) centerpoint)"
             file="$(find-pkg-share autoware_lidar_centerpoint)/launch/lidar_centerpoint.launch.xml">
      <arg name="input/pointcloud" value="/perception/detector/pointcloud"/>
      <arg name="output/objects" value="/perception/detector/objects"/>
      <arg name="model_path" value="$(var centerpoint_model)"/>
      <arg name="common_param_path" value="$(var config)/centerpoint_common.param.yaml"/>
    </include>
    <node if="$(equals $(var detector) centerpoint_cpu)" pkg="people_perception" exec="centerpoint_cpu.py"
          name="lidar_centerpoint" output="screen" launch-prefix="$(var python)">
      <remap from="~/input/pointcloud" to="/perception/detector/pointcloud"/>
      <remap from="~/output/objects" to="/perception/detector/objects"/>
      <param name="model_path" value="$(var centerpoint_model)"/>
      <param from="$(var centerpoint_model)/ml_package.param.yaml" allow_substs="true"/>
      <param from="$(var config)/centerpoint_common.param.yaml"/>
      <param from="$(var config)/centerpoint_cpu.param.yaml"/>
      <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>
  </group>
</launch>
